#!/usr/bin/env python3
"""recall — one key to jump back to anything you had.

Opens the native Omarchy menu with every window (all workspaces), every file
you touched recently, and your clipboard history, in one searchable panel.

    recall            open the panel
    recall --list     print the collected rows (debug)
    recall --selftest run internal checks

Picking a row does the obvious thing: a window gets focused (switching
workspace and monitor if needed), a file opens, a clipboard entry goes back
into the clipboard.

`recall` also remembers what you pick and when, so the things you reach for
at 9am drift to the top at 9am.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
XDG_STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))

USAGE_FILE = XDG_STATE / "recall" / "usage.json"
CONFIG_FILE = XDG_CONFIG / "recall" / "config.json"
CLIPBOARD_FILE = XDG_STATE / "omarchy" / "clipboard-history.json"

DEFAULTS = {
    "dirs": ["~/Work", "~/Documents", "~/Desktop", "~/Pictures", "~/Downloads"],
    "depths": {"~/Downloads": 2},
    "default_depth": 6,
    "max_file_age_days": 60,
    "limits": {"window": 40, "file": 90, "clip": 20},
    "width": 720,
    "max_height": 560,
    "prompt": "Jump",
}

EXCLUDES = [
    ".git",
    "node_modules",
    ".cache",
    "__pycache__",
    ".venv",
    "venv",
    "omarchy-clone-*",
    "*.iso",
    "*.part",
]


# ── small helpers ────────────────────────────────────────────────────────────


def run(argv: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, **kwargs)


INVISIBLES = dict.fromkeys(map(ord, "\u200b\u200c\u200d\u200e\u200f\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069\ufeff"))


def one_line(text: str) -> str:
    """Collapse any text to something a single menu row can hold."""
    text = str(text).translate(INVISIBLES).replace("\t", " ")
    return re.sub(r"\s+", " ", text).strip()


def clip(text: str, width: int) -> str:
    text = one_line(text)
    return text if len(text) <= width else text[: width - 1].rstrip() + "…"


def short_path(path: Path) -> str:
    """~/Work/system-clone, with the head of long paths elided."""
    try:
        text = "~/" + str(path.relative_to(HOME))
    except ValueError:
        text = str(path)
    if len(text) <= 52:
        return text
    return "…/" + text[-50:].lstrip("/")


def age(seconds: float) -> str:
    if seconds < 60:
        return "now"
    if seconds < 3600:
        return f"{int(seconds // 60)}m"
    if seconds < 86400:
        return f"{int(seconds // 3600)}h"
    if seconds < 7 * 86400:
        return f"{int(seconds // 86400)}d"
    if seconds < 35 * 86400:
        return f"{int(seconds // (7 * 86400))}w"
    return f"{int(seconds // (30 * 86400))}mo"


def fingerprint(kind: str, value: str) -> str:
    digest = hashlib.sha1(value.encode("utf-8", "replace")).hexdigest()[:16]
    return f"{kind}:{digest}"


# ── learned ranking ──────────────────────────────────────────────────────────


def load_usage() -> dict:
    try:
        return json.loads(USAGE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def bonus(usage: dict, fp: str, now: float) -> float:
    """How much this item has earned its place, right now."""
    entry = usage.get(fp)
    if not entry:
        return 0.0
    hour = str(time.localtime(now).tm_hour)
    same_hour = min(entry.get("hours", {}).get(hour, 0), 12)
    recent = 1.5 if now - entry.get("last", 0) < 3600 else 0.0
    return 2.0 * same_hour + 0.25 * min(entry.get("n", 0), 20) + recent


def record_pick(fp: str) -> None:
    """Update the usage model and decay old hour buckets so taste can change."""
    now = time.time()
    hour = str(time.localtime(now).tm_hour)
    usage = load_usage()

    for entry in usage.values():
        hours = entry.get("hours", {})
        for key in list(hours):
            decayed = hours[key] * 0.93
            if decayed < 0.2:
                del hours[key]
            else:
                hours[key] = round(decayed, 3)

    entry = usage.setdefault(fp, {"n": 0, "last": 0, "hours": {}})
    entry["n"] = entry.get("n", 0) + 1
    entry["last"] = now
    hours = entry.setdefault("hours", {})
    hours[hour] = hours.get(hour, 0) + 1

    # Keep the file bounded: the model only needs the recently relevant items.
    if len(usage) > 400:
        keep = sorted(usage.items(), key=lambda kv: kv[1].get("last", 0), reverse=True)[:300]
        usage = dict(keep)

    try:
        USAGE_FILE.parent.mkdir(parents=True, exist_ok=True)
        USAGE_FILE.write_text(json.dumps(usage, indent=0, sort_keys=True) + "\n")
    except OSError:
        pass


# ── sources ──────────────────────────────────────────────────────────────────


ICONS = {
    "window": "\uf2d0",   # nerd font: display
    "file": "\uf15b",     # nerd font: file
    "clip": "\uf0ea",     # nerd font: clipboard
    "image": "\uf03e",    # nerd font: image
}


class Row:
    __slots__ = ("kind", "label", "detail", "fingerprint", "base_rank", "action")

    def __init__(self, kind, label, detail, fingerprint, base_rank, action):
        self.kind = kind
        self.label = label
        self.detail = detail
        self.fingerprint = fingerprint
        self.base_rank = base_rank
        self.action = action

    @property
    def key(self) -> str:
        return f"{self.label}\t{self.detail}"


def window_rows(now: float) -> list[Row]:
    result = run(["hyprctl", "-j", "clients"])
    if result.returncode != 0:
        return []
    try:
        clients = json.loads(result.stdout)
    except ValueError:
        return []

    monitors = {}
    mres = run(["hyprctl", "-j", "monitors"])
    if mres.returncode == 0:
        try:
            monitors = {m["id"]: m["name"] for m in json.loads(mres.stdout)}
        except (ValueError, KeyError):
            monitors = {}

    rows = []
    clients = [c for c in clients if c.get("mapped") and not c.get("hidden")]
    clients.sort(key=lambda c: c.get("focusHistoryID", 10 ** 6))

    for client in clients:
        address = client.get("address", "")
        klass = client.get("class") or client.get("initialClass") or "?"
        title = one_line(client.get("title") or klass)
        workspace = client.get("workspace") or {}
        ws = workspace.get("name") or str(workspace.get("id", "?"))
        monitor = monitors.get(client.get("monitor"), "")
        detail = " · ".join(part for part in (klass, f"ws {ws}", monitor) if part)

        rows.append(
            Row(
                kind="window",
                label=clip(title, 88),
                detail=detail,
                fingerprint=fingerprint("window", f"{klass}\x00{title}"),
                base_rank=len(rows),
                action=lambda a=address, w=ws, m=client.get("monitor"): focus_window(a, w, m),
            )
        )
    return rows


def focus_window(address: str, workspace: str, monitor: str | None) -> None:
    """Focus a window, following it to its monitor and workspace.

    Hyprland here is driven through its Lua dispatchers, so each call is a Lua
    expression rather than the old "dispatch focuswindow address:..." form.
    """
    calls = []
    if monitor:
        calls.append(f'hl.dsp.focus({{ monitor = "{monitor}" }})')
    calls.append(f'hl.dsp.focus({{ workspace = "{workspace}" }})')
    calls.append(f'hl.dsp.focus({{ window = "address:{address}" }})')
    for call in calls:
        run(["hyprctl", "dispatch", call])


def file_rows(now: float, config: dict) -> list[Row]:
    paths = []
    for raw in config["dirs"]:
        path = Path(raw).expanduser()
        if path.is_dir():
            paths.append((path, config["depths"].get(raw, config["default_depth"])))
    if not paths:
        return []

    rows: list[Row] = []
    for path, depth in paths:
        argv = [
            "fd", "--type", "f", "--changed-within", f"{config['max_file_age_days']}d",
            "--max-depth", str(depth),
        ]
        for pattern in EXCLUDES:
            argv += ["--exclude", pattern]
        argv += [".", str(path)]

        result = run(argv)
        if result.returncode != 0:
            continue
        for line in result.stdout.splitlines():
            if not line:
                continue
            file = Path(line)
            try:
                stat = file.stat()
            except OSError:
                continue
            rows.append(
                Row(
                    kind="file",
                    label=clip(file.name, 76),
                    detail=f"{short_path(file.parent)} · {age(now - stat.st_mtime)}",
                    fingerprint=fingerprint("file", str(file)),
                    base_rank=-stat.st_mtime,
                    action=lambda p=file: open_path(p),
                )
            )

    rows.sort(key=lambda row: row.base_rank)
    return rows


def open_path(path: Path) -> None:
    subprocess.Popen(
        ["setsid", "xdg-open", str(path)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def clipboard_rows(now: float) -> list[Row]:
    try:
        history = json.loads(CLIPBOARD_FILE.read_text())
    except (OSError, ValueError):
        return []
    if not isinstance(history, list):
        return []

    rows: list[Row] = []
    seen: set[str] = set()
    for entry in history:
        if not isinstance(entry, dict):
            continue
        if entry.get("type") == "text":
            text = str(entry.get("text", ""))
            flat = one_line(text)
            if not flat or flat in seen:
                continue
            seen.add(flat)
            rows.append(
                Row(
                    kind="clip",
                    label=clip(flat, 96),
                    detail="clipboard",
                    fingerprint=fingerprint("clip", flat),
                    base_rank=-len(rows),
                    action=lambda t=text: copy_text(t),
                )
            )
        elif entry.get("type") == "image" and entry.get("path"):
            path = Path(str(entry["path"]))
            if not path.is_file():
                continue
            captured = one_line(entry.get("capturedAt", ""))
            rows.append(
                Row(
                    kind="image",
                    label=f"[image] {clip(path.name, 70)}",
                    detail=" · ".join(p for p in ("clipboard image", captured) if p),
                    fingerprint=fingerprint("image", str(path)),
                    base_rank=-len(rows),
                    action=lambda p=path: open_path(p),
                )
            )
    return rows


def copy_text(text: str) -> None:
    subprocess.run(["wl-copy", "--type", "text/plain"], input=text, text=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    preview = clip(text, 60)
    subprocess.Popen(
        ["notify-send", "-a", "Recall", "-i", "edit-copy", "Copied to clipboard", preview],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


# ── panel ────────────────────────────────────────────────────────────────────


def build_rows(config: dict) -> list[Row]:
    now = time.time()
    usage = load_usage()

    sections = {
        "window": window_rows(now)[: config["limits"]["window"]],
        "file": file_rows(now, config)[: config["limits"]["file"]],
        "clip": clipboard_rows(now)[: config["limits"]["clip"]],
    }

    rows: list[Row] = []
    seen: set[str] = set()
    for kind in ("window", "file", "clip"):
        group = sections[kind]
        # Learned preference first, natural order second. Sorting is stable so
        # untouched items keep their recency.
        group.sort(key=lambda row: -bonus(usage, row.fingerprint, now))
        for row in group:
            if row.key in seen:
                continue
            seen.add(row.key)
            rows.append(row)
    return rows


def render(rows: list[Row]) -> str:
    return "\n".join(
        f"{ICONS.get(row.kind, '')}\t{row.label}\t{row.detail}" for row in rows
    )


def load_config() -> dict:
    config = json.loads(json.dumps(DEFAULTS))
    try:
        user = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        return config
    if isinstance(user, dict):
        for key, value in user.items():
            if key in ("limits", "depths") and isinstance(value, dict):
                config[key].update(value)
            elif key in config:
                config[key] = value
    return config


def main(argv: list[str]) -> int:
    config = load_config()

    if "--version" in argv:
        print("recall 1.0")
        return 0
    if "--selftest" in argv:
        return selftest()

    rows = build_rows(config)

    if "--list" in argv:
        for row in rows:
            print(f"{row.kind:7} {row.label}  ‹{row.detail}›")
        return 0

    if not rows:
        return 1

    by_key = {row.key: row for row in rows}
    result = subprocess.run(
        [
            "omarchy-menu-select", config["prompt"], "--",
            "--width", str(config["width"]),
            "--maxheight", str(config["max_height"]),
        ],
        input=render(rows) + "\n",
        text=True,
        stdout=subprocess.PIPE,
    )
    chosen = (result.stdout or "").rstrip("\n")
    if result.returncode != 0 or not chosen:
        return 1

    row = by_key.get(chosen)
    if row is None:
        # The menu strips the icon column; values are plain "label\tdetail".
        row = next((r for r in rows if f"{r.label}\t{r.detail}" == chosen), None)
    if row is None:
        return 1

    row.action()
    if "--no-learn" not in argv:
        record_pick(row.fingerprint)
    return 0


# ── self test ────────────────────────────────────────────────────────────────


def selftest() -> int:
    failures = []

    def check(name, got, want):
        if got != want:
            failures.append(f"{name}: got {got!r}, want {want!r}")

    check("one_line", one_line("  a\n\tb   c "), "a b c")
    check("clip", clip("abcdef", 4), "abc…")
    check("age now", age(10), "now")
    check("age minutes", age(120), "2m")
    check("age hours", age(7200), "2h")
    check("age days", age(3 * 86400), "3d")
    check("fingerprint stable", fingerprint("file", "/a/b") == fingerprint("file", "/a/b"), True)
    check("fingerprint distinct", fingerprint("file", "/a/b") != fingerprint("file", "/a/c"), True)
    check("short_path", short_path(HOME / "Work"), "~/Work")

    for failure in failures:
        print(f"FAIL {failure}")
    print("ok" if not failures else f"{len(failures)} failure(s)")
    return 0 if not failures else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
